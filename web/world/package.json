{
  "name": "claw-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "가상환경 탭 — Vite + React + TypeScript. 빌드 산출물(build/)을 커밋해 배포·폐쇄망이 Node 없이 돈다.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --mode development --watch",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
