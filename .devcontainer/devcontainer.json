{
  "name": "CLAW_DEMO",

  // 로컬 개발 환경이 Python 3.13이라 같은 버전으로 맞춘다. 의존성에 상한 핀이
  // 없어서 파이썬 버전이 다르면 pip이 다른 조합으로 해석될 수 있다.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",

  "features": {
    // 웹 테스트가 node 내장 러너를 쓴다 (npm 의존 0): cd web && node --test "js/**/*.test.js"
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },

  // 설치 절차는 scripts/setup.sh 한 벌만 유지한다 — 여기에 복제하지 말 것.
  // bash로 호출하는 건 실행 권한(+x)이 유실된 체크아웃에서도 돌게 하기 위함.
  "postCreateCommand": "bash scripts/setup.sh",

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "CLAW 웹 UI",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
